VITE_BKT_API_ENDPOINT=YOUR_API_ENDPOINT
VITE_BKT_API_KEY=YOUR_API_KEY

# Demo flag identifiers (optional; defaults are the placeholders in example/index.ts)
VITE_BKT_FEATURE_TAG=feature-tag
VITE_BKT_FEATURE_ID=feature_id
VITE_BKT_GOAL_ID=goal_id

# SSE streaming. false matches the SDK default (enableStreaming).
# Set to true to demo real-time flag updates.
VITE_BKT_ENABLE_STREAMING=false
# Demo-only: use example/eventSourceAdapter.ts instead of the SDK's built-in
# transport. Only has an effect when VITE_BKT_ENABLE_STREAMING=true.
VITE_BKT_USE_CUSTOM_EVENT_SOURCE=false
